<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**;obj_new\**;bin_new\**;obj_clean\**;bin_clean\**;publish\**;publish_*\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The payment gateway lives in its own assembly on purpose: it knows nothing about
      organizations, add-ons or subscriptions, so it can be referenced by another system as-is
      (or packed to NuGet) rather than copy-pasted. Everything product-specific about buying an
      add-on stays here, in AddOnPurchaseService.
    -->
    <ProjectReference Include="..\..\Hxl.Payments\Hxl.Payments.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Elasticsearch.Net" Version="7.17.5" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.10" />
    <PackageReference Include="MongoDB.Driver" Version="3.5.1" />
    <PackageReference Include="NEST" Version="7.17.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

</Project>
