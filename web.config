<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\RafeeqyNotes.Api.dll"
                stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">
      <environmentVariables>
        <!--
          MUST be Production on the production server.

          This was previously "Development", which had three consequences on the live site:
            1. Swagger was served at the site root, publishing the whole API surface.
            2. The Developer Exception Page returned full stack traces to callers.
            3. appsettings.Development.json was layered over appsettings.json. That file
               points the Google/Microsoft/GitHub OAuth callbacks at http://localhost:5254
               and supplies null / "your-dev-client-id" credentials, so social sign-in
               could not have worked in production.

          Running as Production stops the Development file being loaded, so the real
          callbacks (https://ssbe.squadspace.net/...) and credentials in appsettings.json
          take effect.

          Note: an ASPNETCORE_ENVIRONMENT set at the IIS app-pool level overrides this
          file. If Swagger still appears at the site root, check the app pool.
        -->
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

        <!--
          SECRETS DO NOT GO HERE.

          This file ships inside deploy\api and is in source control, so anything written
          here is published exactly like appsettings.json was. The app now refuses to start
          unless the four required secrets are present in the environment:

              JwtSettings__Key          GitHub__ClientId
              Smtp__Password            GitHub__ClientSecret

          and these two, once real Google/Microsoft OAuth credentials exist:

              Google__ClientId          Microsoft__ClientId
              Google__ClientSecret      Microsoft__ClientSecret

          Set them on the server instead, either way round:

            - IIS Manager > the site > Configuration Editor >
              system.webServer/aspNetCore > environmentVariables  (per-site, preferred), or
            - a machine-level System environment variable, then recycle the app pool.

          The double underscore is the .NET convention for a nested configuration key:
          Smtp__Password binds to Smtp:Password.
        -->
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>
